#: po/strings.c:3
msgid "Window Buttons (MiniOS)"
msgstr "Pulsanti finestra (MiniOS)"

#: po/strings.c:4
msgid "Window buttons with pinning and without grouped-window counters"
msgstr "Pulsanti finestra con funzione di blocco e senza contatori per finestre raggruppate"

#: po/strings.c:5
msgid "_Fill all available panel space"
msgstr "_Occupa tutto lo spazio disponibile nel pannello"

#: po/strings.c:6
msgid "<b>Pinned applications</b>"
msgstr "<b>Applicazioni bloccate</b>"

#: po/strings.c:7
msgid "_Pin to Taskbar"
msgstr "_Blocca sulla barra delle applicazioni"

#: po/strings.c:8
msgid "_Unpin from Taskbar"
msgstr "_Sblocca dalla barra delle applicazioni"
